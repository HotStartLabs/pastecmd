{
  "name": "pastecmd",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-01",
  // ENVIRONMENT is overridden to "dev" by .dev.vars under `wrangler dev`,
  // which gates the https redirect (local dev serves plain http).
  // CANONICAL_HOST is the app's one origin: everything else redirects to it,
  // and it's the only origin allowed in connect-src and on the relay.
  "vars": { "ENVIRONMENT": "production", "CANONICAL_HOST": "pastecmd.com" },
  // Serve only on the custom domains below. workers.dev and per-version
  // preview URLs would otherwise be public second origins for the app.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "pastecmd.com", "custom_domain": true },
    { "pattern": "www.pastecmd.com", "custom_domain": true },
    { "pattern": "pastecommand.com", "custom_domain": true },
    { "pattern": "www.pastecommand.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Run the worker before serving assets so scheme/host redirects
    // (http→https, pastecommand.com→pastecmd.com) apply to every request.
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SESSIONS",
        "class_name": "Session"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Session"]
    }
  ]
}
